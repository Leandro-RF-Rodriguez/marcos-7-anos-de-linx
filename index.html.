<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Marcos 7 Anos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Syne:wght@600;700;800&family=Manrope:wght@400;500;700&display=swap">
<style>
/* Layout: "A Jornada" — página escura editorial: hero com foto ao pôr do sol, números, cronograma em círculos, galeria P&B, bolo com 7 velas, recado final */
:root{
  --bg:#070708; --panel:#111114; --line:#2a2a30; --fg:#f4f2ee; --muted:#9b98a3;
  --violet:#8b3dff; --blue:#3f7bff; --spark:#ff6a2b; --flame:#ffb547;
  --serif:"Cormorant Garamond","Times New Roman",serif;
  --display:"Syne","Arial Black",sans-serif;
  --body:"Manrope","Segoe UI",Arial,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{overflow-x:hidden}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:16px;line-height:1.6;margin:0}
#confetti{position:fixed;inset:0;width:100%;height:100%;z-index:20;pointer-events:none}
.wrap{max-width:1120px;margin:0 auto;padding-inline:20px}
section{padding-block:88px}
.kicker{font-family:var(--serif);letter-spacing:.42em;text-transform:uppercase;font-size:1.05rem;color:var(--fg);margin:0}
h2{font-family:var(--display);font-weight:700;font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.1;margin:0;text-wrap:balance}
.center{text-align:center}
.grad{background:linear-gradient(90deg,var(--violet),var(--blue));-webkit-background-clip:text;background-clip:text;color:transparent}

/* HERO */
.hero{position:relative;min-height:640px;display:flex;align-items:center;overflow:hidden;padding-block:72px}
.hero-img{position:absolute;inset:0 0 0 38%;background:url("data:image/jpeg;base64,") center/cover no-repeat}
.hero-img::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--bg) 0%,rgba(7,7,8,.55) 35%,rgba(7,7,8,.1) 70%),linear-gradient(0deg,var(--bg) 0%,transparent 30%)}
.dust{position:absolute;inset:0;pointer-events:none}
.hero .wrap{position:relative;width:100%}
.hero-text{max-width:500px;display:flex;flex-direction:column;gap:22px}
.hero h1{font-family:var(--display);font-weight:800;font-size:clamp(2.4rem,6vw,4rem);line-height:1.02;margin:0;letter-spacing:-.01em}
.hero h1 .seven{font-family:var(--serif);font-weight:500;font-style:italic;font-size:1.25em;color:var(--flame);letter-spacing:0}
.hero p{margin:0;color:#cfccd6;font-size:1.05rem;max-width:42ch}
.cta{align-self:flex-start;display:inline-flex;align-items:center;gap:10px;font-family:var(--body);font-weight:700;font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;
  color:#fff;background:linear-gradient(90deg,var(--violet),var(--blue));border:0;border-radius:6px;padding:15px 26px;cursor:pointer;text-decoration:none;
  box-shadow:0 12px 30px -12px rgba(139,61,255,.8);transition:transform .2s,box-shadow .2s}
.cta:hover{transform:translateY(-2px);box-shadow:0 16px 34px -12px rgba(63,123,255,.9)}
.cta:focus-visible{outline:2px solid var(--flame);outline-offset:3px}
.tag{font-size:.82rem;color:var(--muted);display:flex;align-items:center;gap:8px}
.tag i{width:8px;height:8px;border-radius:50%;background:var(--spark);box-shadow:0 0 10px var(--spark)}

/* NÚMEROS */
.nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:40px}
.num{background:var(--panel);padding:28px 22px;display:flex;flex-direction:column;gap:4px}
.num b{font-family:var(--display);font-size:clamp(2rem,4.5vw,3rem);line-height:1;font-variant-numeric:tabular-nums}
.num span{color:var(--muted);font-size:.9rem}
.num:first-child b{color:var(--flame)}

/* CRONOGRAMA */
.timeline{position:relative;margin-top:56px;overflow-x:auto;padding-bottom:12px}
.track{display:grid;grid-template-columns:repeat(8,minmax(104px,1fr));gap:8px;min-width:880px;position:relative}
.track::before{content:"";position:absolute;left:5%;right:5%;top:46px;border-top:1.5px dashed #4a4852}
.step{display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;position:relative}
.dot{width:92px;height:92px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;font-family:var(--serif);font-size:1.45rem;font-weight:500;
  box-shadow:0 0 0 6px var(--bg),0 0 0 7px #3a3842;transition:transform .3s}
.step:hover .dot{transform:scale(1.07)}
.step.last .dot{background:linear-gradient(135deg,var(--violet),var(--blue));color:#fff;box-shadow:0 0 0 6px var(--bg),0 0 0 7px var(--violet),0 0 40px -4px var(--violet)}
.step small{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);line-height:1.5;max-width:13ch}
.step.last small{color:var(--fg)}

/* GALERIA */
.light{background:#efefed;color:#121214}
.light .kicker{color:#121214}
.gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:40px}
.ph{margin:0;display:flex;flex-direction:column;gap:10px}
.ph .frame{position:relative;overflow:hidden;border-radius:8px;aspect-ratio:4/5;background:#ccc}
.ph img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(1) contrast(1.05);transition:filter .5s,transform .6s}
.ph:hover img,.ph:focus-within img{filter:none;transform:scale(1.04)}
.ph .chip{position:absolute;left:10px;bottom:10px;background:rgba(18,18,20,.72);color:#fff;font-size:.72rem;padding:4px 12px;border-radius:20px;backdrop-filter:blur(4px)}
.ph figcaption{font-family:var(--display);font-weight:700;font-size:1rem}
.ph figcaption span{display:block;font-family:var(--body);font-weight:400;font-size:.88rem;color:#55545a;margin-top:2px}
.hint-g{margin-top:16px;color:#55545a;font-size:.85rem;text-align:center}

/* BOLO */
.cake-sec{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
.cake-sec p{color:var(--muted);margin:14px 0 0;max-width:40ch}
.cake-status{margin-top:22px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.pill{border:1px solid var(--line);border-radius:30px;padding:6px 16px;font-variant-numeric:tabular-nums;font-weight:700;font-size:.9rem}
.done-msg{font-family:var(--serif);font-style:italic;font-size:1.6rem;color:var(--flame)}
.ghost{font-family:var(--body);font-weight:700;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;background:transparent;color:var(--fg);border:1px solid var(--fg);border-radius:6px;padding:10px 18px;cursor:pointer}
.ghost:hover{background:var(--fg);color:var(--bg)}
.ghost:focus-visible{outline:2px solid var(--flame);outline-offset:3px}
.cake{position:relative;width:min(440px,100%);aspect-ratio:1.1;justify-self:center}
.plate{position:absolute;left:2%;right:2%;bottom:4%;height:9%;border-radius:50%;background:radial-gradient(#3a3842,#1b1a1f)}
.tier{position:absolute;left:50%;transform:translateX(-50%);border-radius:14px 14px 10px 10px}
.t1{bottom:9%;width:86%;height:34%;background:linear-gradient(90deg,#4a1fa8,#2b56d8)}
.t2{bottom:41%;width:62%;height:26%;background:linear-gradient(90deg,#5f2bd0,#3f7bff)}
.tier::before{content:"";position:absolute;left:0;right:0;top:0;height:30%;border-radius:14px 14px 40% 40%/14px 14px 100% 100%;
  background:#f4f2ee;clip-path:polygon(0 0,100% 0,100% 60%,94% 100%,86% 55%,76% 95%,66% 50%,55% 100%,44% 55%,33% 95%,22% 50%,12% 100%,0 60%)}
.t1::after{content:"7 ANOS";position:absolute;left:0;right:0;bottom:16%;text-align:center;font-family:var(--display);font-weight:800;letter-spacing:.3em;color:rgba(255,255,255,.9);font-size:clamp(.9rem,3vw,1.3rem)}
.candles{position:absolute;bottom:66%;left:22%;right:22%;display:flex;justify-content:space-between;align-items:flex-end}
.candle{position:relative;width:12%;max-width:22px;height:clamp(54px,14vw,80px);border:0;padding:0;cursor:pointer;border-radius:3px 3px 0 0;
  background:repeating-linear-gradient(135deg,#fff 0 6px,var(--spark) 6px 12px)}
.candle::before{content:"";position:absolute;left:50%;top:-8px;width:2px;height:8px;background:#222;transform:translateX(-50%)}
.flame{position:absolute;left:50%;top:-34px;width:16px;height:26px;transform:translateX(-50%);border-radius:50% 50% 50% 50%/60% 60% 40% 40%;
  background:radial-gradient(circle at 50% 70%,#fff 0 15%,var(--flame) 40%,var(--spark) 75%,transparent 76%);
  box-shadow:0 0 18px 6px rgba(255,150,60,.45);animation:flick .18s ease-in-out infinite alternate;transform-origin:50% 100%}
.candle.out .flame{display:none}
.smoke{position:absolute;left:50%;top:-30px;width:8px;height:8px;border-radius:50%;background:rgba(200,200,210,.5);animation:smoke 1.4s ease-out forwards;pointer-events:none}
.candle:focus-visible{outline:2px solid var(--flame);outline-offset:4px}
@keyframes flick{from{transform:translateX(-50%) rotate(-3deg) scaleY(1)}to{transform:translateX(-50%) rotate(3deg) scaleY(1.08)}}
@keyframes smoke{to{transform:translate(-50%,-60px) scale(3);opacity:0}}

/* RECADO */
.note-sec{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:56px;align-items:center}
.portrait{position:relative;border-radius:10px;overflow:hidden;aspect-ratio:4/5;max-width:420px;width:100%}
.portrait img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);display:block}
.portrait::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,7,8,.6),transparent 40%)}
.portrait span{position:absolute;left:16px;bottom:14px;z-index:1;font-family:var(--serif);letter-spacing:.3em;text-transform:uppercase}
.note-sec .txt{display:flex;flex-direction:column;gap:18px}
.note-sec .txt p{margin:0;color:#cfccd6;max-width:56ch}
.note-sec blockquote{margin:0;font-family:var(--serif);font-style:italic;font-size:clamp(1.4rem,3vw,1.9rem);line-height:1.3;color:var(--fg);border-left:2px solid var(--violet);padding-left:18px}

footer{border-top:1px solid var(--line);padding-block:56px;display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center}
footer .sign{display:flex;align-items:center;gap:14px}
footer .sign img{width:52px;height:52px;border-radius:50%;object-fit:cover;filter:grayscale(1)}
footer .sign b{font-family:var(--serif);font-size:1.6rem;font-weight:500;font-style:italic}
footer small{color:var(--muted)}

.toast{position:fixed;left:50%;top:50%;z-index:30;transform:translate(-50%,-50%) scale(.6);opacity:0;pointer-events:none;
  background:var(--panel);border:1px solid var(--violet);border-radius:14px;padding:24px 36px;text-align:center;max-width:calc(100% - 32px);
  box-shadow:0 0 60px -10px var(--violet);transition:opacity .2s,transform .25s cubic-bezier(.3,1.6,.5,1)}
.toast.show{opacity:1;transform:translate(-50%,-50%) scale(1);animation:shake .45s .15s}
.toast strong{display:block;font-family:var(--display);font-weight:800;font-size:clamp(1.8rem,6vw,2.8rem);line-height:1.05}
.toast span{color:var(--muted)}
@keyframes shake{0%,100%{margin-left:0}20%{margin-left:-10px}40%{margin-left:10px}60%{margin-left:-7px}80%{margin-left:7px}}

@media (max-width:860px){
  .hero{min-height:0;padding-block:0 56px;flex-direction:column;align-items:stretch}
  .hero-img{position:relative;inset:auto;height:340px;width:100%}
  .hero-img::after{background:linear-gradient(0deg,var(--bg) 0%,transparent 45%)}
  .hero .wrap{margin-top:-60px}
  .nums{grid-template-columns:repeat(2,minmax(0,1fr))}
  .gallery{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cake-sec,.note-sec{grid-template-columns:1fr}
  .portrait{justify-self:center;max-width:340px}
  section{padding-block:64px}
}
@media (prefers-reduced-motion:reduce){.flame{animation:none}.ph img,.dot{transition:none}}
</style></head><body>

<canvas id="confetti" aria-hidden="true"></canvas>
<div class="toast" id="toast" role="alert"><strong>Para de ser doente!</strong><span>Sete anos de casa e ainda gastando confete à toa?</span></div>

<header class="hero">
  <div class="hero-img" role="img" aria-label="Marcos na praia ao pôr do sol, chutando a água"></div>
  <div class="wrap">
    <div class="hero-text">
      <p class="kicker">A jornada</p>
      <h1>Marcos, <span class="seven">7</span> anos de casa.</h1>
      <p>Sete anos de Linx, e agora de TOTVS também. Tem gente que passa pela empresa e tem gente que ajuda a construir ela. Obrigado por estar com a gente em cada etapa.</p>
      <a class="cta" href="#bolo">Assoprar as 7 velas</a>
      <span class="tag"><i></i>Linx agora é TOTVS. E o Marcos continua sendo o Marcos.</span>
    </div>
  </div>
</header>

<main>
  <section class="wrap">
    <h2 class="center">Sete anos <span class="grad">em números</span></h2>
    <div class="nums">
      <div class="num"><b>7</b><span>anos de casa</span></div>
      <div class="num"><b>84</b><span>meses</span></div>
      <div class="num"><b>2.557</b><span>dias, contando os bissextos</span></div>
      <div class="num"><b>2</b><span>marcas no crachá: Linx e TOTVS</span></div>
    </div>
  </section>

  <section class="wrap" style="padding-top:0">
    <p class="kicker center">Cronograma</p>
    <div class="timeline" tabindex="0" aria-label="Linha do tempo de 2019 a 2026">
      <div class="track" id="track"></div>
    </div>
  </section>

  <section class="light">
    <div class="wrap">
      <h2 class="center">Fora do expediente</h2>
      <div class="gallery">
        <figure class="ph" tabindex="0"><div class="frame"><img src="data:image/jpeg;base64," alt="Marcos tirando selfie no espelho do escritório"><span class="chip">No escritório</span></div>
          <figcaption>Pronto pro expediente<span>Selfie oficial do corredor.</span></figcaption></figure>
        <figure class="ph" tabindex="0"><div class="frame"><img src="data:image/jpeg;base64," alt="Marcos de braços abertos na beira de um penhasco diante do mar"><span class="chip">Visão</span></div>
          <figcaption>Olhando longe<span>Sempre de olho no próximo passo.</span></figcaption></figure>
        <figure class="ph" tabindex="0"><div class="frame"><img src="data:image/jpeg;base64," alt="Marcos subindo uma escada estreita em um paredão de pedra"><span class="chip">Escalada</span></div>
          <figcaption>Degrau por degrau<span>Sete anos subindo, um de cada vez.</span></figcaption></figure>
        <figure class="ph" tabindex="0"><div class="frame"><img src="data:image/jpeg;base64," alt="Silhueta do Marcos chutando a água do mar ao pôr do sol"><span class="chip">Energia</span></div>
          <figcaption>Chutando de primeira<span>Mesmo depois de sete anos.</span></figcaption></figure>
      </div>
      <p class="hint-g">Passe o mouse (ou toque) nas fotos para ver as cores.</p>
    </div>
  </section>

  <section class="wrap cake-sec" id="bolo">
    <div>
      <p class="kicker">Faça um pedido</p>
      <h2 style="margin-top:14px">Uma vela para <span class="grad">cada ano</span></h2>
      <p>Clique nas velas para apagar. Quando a última apagar, o pedido está feito.</p>
      <div class="cake-status" aria-live="polite">
        <span class="pill" id="count">7 velas acesas</span>
        <span class="done-msg" id="done" hidden>Parabéns pelos 7 anos, Marcos!</span>
        <button class="ghost" id="relight" type="button" hidden>Acender de novo</button>
      </div>
    </div>
    <div class="cake">
      <div class="plate"></div>
      <div class="tier t1"></div>
      <div class="tier t2"></div>
      <div class="candles" id="candles"></div>
    </div>
  </section>

  <section class="wrap note-sec">
    <div class="portrait"><img src="data:image/jpeg;base64," alt="Retrato do Marcos"><span>Marcos</span></div>
    <div class="txt">
      <p class="kicker">O homenageado</p>
      <blockquote>Sete anos não se completam por acaso. Se completam com parceria, paciência e muita vontade de fazer dar certo.</blockquote>
      <p>Marcos, obrigado por cada chamado resolvido, cada ajuda no corredor e cada risada que deixou o dia mais leve. A empresa mudou de nome, mas uma coisa continua igual: é muito bom ter você no time.</p>
      <button class="cta" id="party" type="button">Soltar confetes</button>
    </div>
  </section>
</main>

<footer class="wrap">
  <div class="sign"><img src="data:image/jpeg;base64," alt=""><b>Com carinho, sua equipe</b></div>
  <small>Linx agora é TOTVS · 7 anos de Marcos</small>
</footer>

<script>
(function(){
  // Cronograma
  const labels={2019:'Primeiro dia de crachá',2020:'1 ano',2021:'2 anos',2022:'3 anos',2023:'4 anos',2024:'5 anos',2025:'6 anos',2026:'7 anos · Linx agora é TOTVS'};
  const tr=document.getElementById('track');
  Object.keys(labels).forEach((y,i,a)=>{const s=document.createElement('div');s.className='step'+(i===a.length-1?' last':'');
    s.innerHTML=`<span class="dot">${y}</span><small>${labels[y]}</small>`;tr.appendChild(s)});

  // Confetes
  const cv=document.getElementById('confetti'),ctx=cv.getContext('2d');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cols=['#8b3dff','#3f7bff','#ff6a2b','#ffb547','#f4f2ee'];
  let W,H,parts=[],running=false;
  function size(){const d=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;ctx.setTransform(d,0,0,d,0,0)}
  size();addEventListener('resize',size);
  function mk(x,y){return{x:(x??W/2)+(Math.random()-.5)*(x!=null?30:160),y:y??H*.8,vx:(Math.random()-.5)*14,vy:-8-Math.random()*10,
    r:Math.random()*Math.PI,vr:(Math.random()-.5)*.2,w:5+Math.random()*6,h:3+Math.random()*9,c:cols[Math.random()*cols.length|0]}}
  function draw(){ctx.clearRect(0,0,W,H);
    parts.forEach(p=>{p.vy+=.28;p.vx*=.985;p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.fillStyle=p.c;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore()});
    parts=parts.filter(p=>p.y<H+40);if(parts.length)requestAnimationFrame(draw);else running=false}
  function burst(x,y,n){for(let i=0;i<n;i++)parts.push(mk(x,y));if(!running){running=true;requestAnimationFrame(draw)}}

  // Poeira dourada no hero
  if(!reduce){const hero=document.querySelector('.hero'),c=document.createElement('canvas');c.className='dust';hero.prepend(c);const x=c.getContext('2d');let w,h,pts=[];
    function rs(){w=c.width=hero.clientWidth;h=c.height=hero.clientHeight}rs();addEventListener('resize',rs);
    for(let i=0;i<70;i++)pts.push({x:Math.random(),y:Math.random(),r:Math.random()*1.6+.3,v:Math.random()*.0006+.0002,a:Math.random()});
    (function loop(){x.clearRect(0,0,w,h);pts.forEach(p=>{p.y-=p.v;if(p.y<0)p.y=1;p.a+=.02;x.globalAlpha=.25+Math.sin(p.a)*.25;x.fillStyle='#ffd9a0';x.beginPath();x.arc(p.x*w,p.y*h,p.r,0,7);x.fill()});requestAnimationFrame(loop)})();}

  // Som de sopro
  let actx=null;
  function blow(){try{actx=actx||new (window.AudioContext||window.webkitAudioContext)();const a=actx,n=a.sampleRate*.35,b=a.createBuffer(1,n,a.sampleRate),ch=b.getChannelData(0);
    for(let i=0;i<n;i++)ch[i]=(Math.random()*2-1)*Math.sin(Math.PI*i/n)*.6;const s=a.createBufferSource(),f=a.createBiquadFilter();f.type='bandpass';f.frequency.value=900;f.Q.value=.6;
    s.buffer=b;s.connect(f).connect(a.destination);s.start()}catch(e){}}

  // Velas
  const host=document.getElementById('candles'),count=document.getElementById('count'),done=document.getElementById('done'),relight=document.getElementById('relight');
  let lit=7;
  const candles=Array.from({length:7},(_,i)=>{const c=document.createElement('button');c.type='button';c.className='candle';c.setAttribute('aria-label','Apagar vela '+(i+1));
    c.innerHTML='<span class="flame"></span>';c.addEventListener('click',()=>out(c));host.appendChild(c);return c});
  function out(c){if(c.classList.contains('out'))return;c.classList.add('out');blow();
    const s=document.createElement('span');s.className='smoke';c.appendChild(s);setTimeout(()=>s.remove(),1400);
    lit--;count.textContent=lit===1?'1 vela acesa':lit+' velas acesas';
    if(!lit){count.textContent='Pedido feito!';done.hidden=false;relight.hidden=false;const r=host.getBoundingClientRect();burst(r.left+r.width/2,r.top,260)}}
  relight.addEventListener('click',()=>{candles.forEach(c=>c.classList.remove('out'));lit=7;count.textContent='7 velas acesas';done.hidden=true;relight.hidden=true});

  // Confete + aviso
  const toast=document.getElementById('toast');let clicks=[],tt;
  document.getElementById('party').addEventListener('click',e=>{
    const now=Date.now();clicks=clicks.filter(c=>now-c<2000);clicks.push(now);
    if(clicks.length>=4){clicks=[];toast.classList.remove('show');void toast.offsetWidth;toast.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>toast.classList.remove('show'),2600)}
    burst(e.clientX||W/2,e.clientY||H*.7,180)});
})();
</script>
</body></html>
